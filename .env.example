# Copy this file to .env for local production-mode testing.
# Never commit the real .env file.

PROCTORVISION_ENVIRONMENT=development
PROCTORVISION_PRELOAD_MODEL=true
PROCTORVISION_WARMUP_MODEL=true
PROCTORVISION_PREFER_OPENVINO=true

# Leave empty for normal local development. Set a long random temporary value
# before exposing a supervisor demo on the internet.
PROCTORVISION_ACCESS_TOKEN=
PROCTORVISION_ACCESS_SESSION_HOURS=8
PROCTORVISION_SECURE_COOKIES=false

# Same-origin production deployment needs no CORS entries. These defaults allow
# the local Vite development server to reach FastAPI.
PROCTORVISION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose overrides these paths to its persistent /app/storage volume.
# PROCTORVISION_DATABASE_PATH=E:/ProctorVision_AI/data/proctorvision.db
# PROCTORVISION_EVIDENCE_DIRECTORY=E:/ProctorVision_AI/evidence
